{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/consult", "destination": "/api/consult" },
    { "source": "/stream", "destination": "/api/stream" },
    { "source": "/summary", "destination": "/api/summary" },
    { "source": "/voice", "destination": "/api/voice" },
    { "source": "/screen", "destination": "/api/screen" },
    { "source": "/speak", "destination": "/api/speak" },
    { "source": "/retrieve", "destination": "/api/retrieve" }
  ],
  "functions": {
    "api/*.py": { "maxDuration": 60, "includeFiles": "{rag/medi_index.json,i18n/translations.json}" }
  }
}
