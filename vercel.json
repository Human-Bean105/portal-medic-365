{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/consult", "destination": "/api/consult" },
    { "source": "/summary", "destination": "/api/summary" },
    { "source": "/voice", "destination": "/api/voice" },
    { "source": "/screen", "destination": "/api/screen" }
